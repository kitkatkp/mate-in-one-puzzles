{
  "name": "mate-in-one-puzzles",
  "version": "1.0.0",
  "description": "Verified mate-in-one chess puzzle library and validation tools.",
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate:curriculum": "tsx scripts/validate-curriculum.ts",
    "research:verify": "tsx research/verify_with_chessjs.ts",
    "build": "tsx scripts/build.ts",
    "dev": "npm run build && tsx scripts/serve.ts",
    "preview": "tsx scripts/serve.ts",
    "check": "npm run typecheck && npm test && npm run validate && npm run validate:curriculum && npm run build"
  },
  "keywords": [
    "chess",
    "mate-in-one",
    "puzzles",
    "validation"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "chess.js": "^1.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "@types/node": "^20.19.43",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
